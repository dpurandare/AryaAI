{
  "name": "sachiv",
  "version": "0.1.0",
  "description": "Sachiv — your local-first, multi-agent AI companion.",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "author": {
    "name": "Deepak Purandare",
    "email": "dpurandare@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@google/genai": "^2.21.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.8.9",
    "js-tiktoken": "^1.0.21",
    "marked": "^18.0.12",
    "openai": "^7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "icon-gen": "^5.0.0",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "@google/genai@2.21.0": true,
    "protobufjs@7.6.6": true,
    "sharp@0.35.4": true
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
