{
  "name": "sachivji",
  "version": "0.2.2",
  "description": "Sachivji — your local-first, multi-agent AI companion.",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "author": {
    "name": "Deepak Purandare",
    "email": "dpurandare@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs && node scripts/brand-electron-dev.mjs",
    "predev": "node scripts/brand-electron-dev.mjs",
    "dev": "electron-vite dev",
    "prestart": "node scripts/brand-electron-dev.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "fetch:bundled-python:win": "node scripts/fetch-bundled-python-win.mjs",
    "predist:win": "npm run fetch:bundled-python:win",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@google/genai": "^2.21.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.7.1",
    "docxtemplater": "^3.70.1",
    "dompurify": "^3.4.15",
    "dotenv": "^18.0.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.1",
    "js-tiktoken": "^1.0.21",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "mammoth": "^1.12.3",
    "marked": "^18.0.12",
    "mermaid": "^12.0.0",
    "mssql": "^12.7.2",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "openai": "^7.10.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "pizzip": "^3.2.0",
    "pptxgenjs": "^4.0.1",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "icon-gen": "^5.0.0",
    "sharp": "^0.35.4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "@google/genai@2.21.0": true,
    "protobufjs@7.6.6": true,
    "sharp@0.35.4": true
  },
  "overrides": {
    "sharp": "^0.35.4",
    "image-size": "^2.0.4",
    "uuid": "^11.1.1",
    "lodash-es": "^4.18.1"
  }
}
