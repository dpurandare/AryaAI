  KNN --> CUT["keep distance 0.5 or less<br/>(relevance 0.5 or more), best first, limit 5 (max 10)"]
  CUT --> OUT(["excerpts of 800 chars at most,<br/>each tagged with session title,<br/>date and relevance, plus a<br/>'these are past statements' note"])
